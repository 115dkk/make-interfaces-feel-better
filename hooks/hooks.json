{
  "description": "Checks Korean interface copy and READMEs against write.md before they are written.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/korean_judge.py",
              "--rules",
              "${CLAUDE_PLUGIN_ROOT}/skills/make-interfaces-feel-better/write.md",
              "--scope",
              "copy",
              "--label",
              "화면 문구 판정(write.md)"
            ],
            "timeout": 180,
            "statusMessage": "write.md copy check (Claude Sonnet 5.5)"
          }
        ]
      }
    ]
  }
}
